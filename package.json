{
  "name": "avaliacao",
  "version": "1.0.0",
  "description": "Testes automatizados da avaliação de QA no Sauce Demo, com Playwright e TypeScript.",
  "main": "index.js",
  "scripts": {
    "test": "playwright test --project=webkit",
    "test:chromium": "playwright test --project=chromium",
    "test:alta": "playwright test --project=webkit --grep @alta",
    "test:ui": "playwright test --project=webkit --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "test:webkit": "playwright test --project=webkit",
    "test:todos": "playwright test"
  },
  "keywords": [],
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "pdf-parse": "^2.4.5",
    "typescript": "^7.0.2"
  }
}
